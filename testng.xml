<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="GraphQL API Test Suite" parallel="tests" thread-count="1">
    
    <listeners>
        <listener class-name="listeners.ExtentReportListener"/>
    </listeners>
    
    <test name="Authentication Tests">
        <classes>
            <class name="tests.auth.LoginTest"/>
        </classes>
    </test>
    
    <test name="User Service Tests">
        <classes>
            <class name="tests.UserServiceTest"/>
        </classes>
    </test>
    
    <test name="Chapter Management Tests">
        <classes>
            <class name="tests.chapter.CreateChapterTest"/>
            <class name="tests.chapter.UpdateChapterTest"/>
            <class name="tests.chapter.DeleteChapterTest"/>
        </classes>
    </test>
    
    <test name="Content Management Tests">
        <classes>
            <class name="tests.content.CreateContentTest"/>
            <class name="tests.content.UpdateContentTest"/>
            <class name="tests.content.DeleteContentTest"/>
        </classes>
    </test>
    
    <test name="Division Management Tests">
        <classes>
            <class name="tests.division.CreateDivisionTest"/>
            <class name="tests.division.UpdateDivisionTest"/>
            <class name="tests.division.DeleteDivisionTest"/>
        </classes>
    </test>
    
    <test name="Employee Management Tests">
        <classes>
            <class name="tests.employee.CreateEmployeeTest"/>
            <class name="tests.employee.UpdateEmployeeTest"/>
            <class name="tests.employee.DeleteEmployeeTest"/>
        </classes>
    </test>
    
    <test name="Training Management Tests">
        <classes>
            <class name="tests.training.CreateTrainingTest"/>
            <class name="tests.training.UpdateTrainingTest"/>
            <class name="tests.training.DeleteTrainingTest"/>
        </classes>
    </test>
    
</suite>
